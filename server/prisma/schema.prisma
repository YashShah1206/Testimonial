generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  email       String
  company     String?
  testimonial String
  rating      Int      // Validated in application logic to be between 1 and 5
  photo       String?  // Optional URL or file path to uploaded photo
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
